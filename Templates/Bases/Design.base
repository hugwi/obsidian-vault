filters:
  and:
    - domain.contains("design")
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Note
  theme:
    displayName: Theme
  subtheme:
    displayName: Sub-theme
  file.tags:
    displayName: Tags
  rating:
    displayName: Rating
  action:
    displayName: Action
  platform:
    displayName: Platform
  thumbnail_url:
    displayName: Thumbnail
  source:
    displayName: Source
views:
  - type: table
    name: 📐 Method & toolkit
    filters:
      and:
        - file.folder == ""
        - file.tags.contains("design-automation")
    order:
      - file.name
      - theme
      - subtheme
      - file.tags
  - type: table
    name: 🛠 Tools & skills
    filters:
      and:
        - file.folder == "Raw"
        - or:
            - file.tags.contains("skills")
            - file.tags.contains("claude-code")
    order:
      - file.name
      - rating
      - action
      - source
  - type: cards
    name: 🖼 Inspiration
    filters:
      and:
        - type == "inspiration"
    image: thumbnail_url
    order:
      - file.name
      - platform
      - rating
  - type: table
    name: 🎨 Craft references
    filters:
      and:
        - file.folder == "Raw"
        - '!file.tags.contains("skills")'
    order:
      - file.name
      - rating
      - action
      - source
  - type: table
    name: 🔨 To implement
    filters:
      and:
        - action == "implement"
    order:
      - file.name
      - rating
      - subtheme
  - type: table
    name: ⭐ Top rated
    filters:
      and:
        - rating >= 5
    sort:
      - property: rating
        direction: DESC
    order:
      - file.name
      - rating
      - action
  - type: table
    name: All design notes
    order:
      - file.name
      - theme
      - subtheme
      - rating
      - action
