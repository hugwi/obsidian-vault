filters:
  and:
    - domain.contains("design")
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Note
  type:
    displayName: Type
  stars:
    displayName: Stars
  rating:
    displayName: Rating
  published:
    displayName: Published
  created:
    displayName: Added
  source:
    displayName: Source
views:
  - type: table
    name: All design
    order:
      - file.name
      - type
      - stars
      - rating
      - published
      - created
      - source
    sort:
      - property: rating
        direction: DESC
      - property: published
        direction: DESC
      - property: created
        direction: DESC
    columnSize:
      file.name: 480
  - type: cards
    name: 🖼 Inspiration
    filters:
      and:
        - type == "inspiration"
    order:
      - file.name
      - platform
      - rating
    image: thumbnail_url
